# Bus Cignal — 환경 변수 예시
# .env.local 파일을 만들고 아래 변수를 채우세요. 실제 값은 East_Star에게 요청.
# .env.local은 절대 commit하지 마세요 (.gitignore에 등록됨).

# ─── Supabase ──────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ─── Firebase (채팅 전용) ────────────────────────
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
FIREBASE_ADMIN_PRIVATE_KEY=
FIREBASE_ADMIN_CLIENT_EMAIL=

# ─── 카카오맵 ───────────────────────────────────
NEXT_PUBLIC_KAKAO_MAP_API_KEY=
KAKAO_REST_API_KEY=

# ─── 마스터 인증 (추가 비밀번호) ─────────────────
MASTER_PASSWORD_HASH=
MASTER_SESSION_SECRET=        # 마스터 세션 JWT 서명 키 (랜덤 32자+)

# ─── 간사 인증 (CCC 로그인, v1.1) ───────────────
OPERATOR_SESSION_SECRET=      # 간사 세션 JWT 서명 키 (랜덤 32자+)
# CCC 신원 전달 방식·검증 키는 CCC IT 확정 후 추가 (예: CCC_TOKEN_PUBLIC_KEY / CCC_VERIFY_URL)

# ─── 개발 전용 ─────────────────────────────────
# ENABLE_DEV_LOGIN=true        # /dev/login (seed 간사·마스터 로그인) 활성. ⚠️ 프로덕션 X

# ─── 알림 (출시 직전 확정) ──────────────────────
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=

# ─── Vercel·기타 ────────────────────────────────
# NEXT_PUBLIC_APP_URL=http://localhost:3000
