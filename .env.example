# Bus Cignal — 환경 변수 예시
# .env.local 파일을 만들고 아래 변수를 채우세요. 실제 값은 East_Star에게 요청.
# .env.local은 절대 commit하지 마세요 (.gitignore에 등록됨).

# ─── Supabase ──────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ─── Firebase (채팅 + FCM 웹푸시) ─────────────────
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Admin SDK — 서버 FCM 푸시 발송(lib/firebase/admin.ts). 한 줄 저장 시 \n 리터럴 사용.
FIREBASE_ADMIN_PRIVATE_KEY=
FIREBASE_ADMIN_CLIENT_EMAIL=
# FCM 웹푸시 VAPID 공개키 — Phase C 클라이언트 getToken()에 사용 (Firebase 콘솔 → Cloud Messaging → 웹 푸시 인증서)
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# ─── 카카오맵 ───────────────────────────────────
NEXT_PUBLIC_KAKAO_MAP_API_KEY=
KAKAO_REST_API_KEY=

# ─── 마스터 인증 (추가 비밀번호) ─────────────────
# ⚠️ bcrypt 해시($2b$12$…)의 '$'는 .env 파일에선 '\$'로 이스케이프할 것.
#    (Next @next/env가 dotenv 변수확장으로 $2b·$12를 먹어 접두사가 잘림 → 마스터 로그인 실패)
#    예: MASTER_PASSWORD_HASH=\$2b\$12\$abc...
#    Vercel 등 호스팅 대시보드 env에는 RAW 값($2b$12$…, 이스케이프 X)을 그대로 입력.
MASTER_PASSWORD_HASH=
MASTER_SESSION_SECRET=        # 마스터 세션 JWT 서명 키 (랜덤 32자+)

# ─── 간사 인증 (CCC 로그인, v1.1) ───────────────
OPERATOR_SESSION_SECRET=      # 간사 세션 JWT 서명 키 (랜덤 32자+)
PASSENGER_SESSION_SECRET=     # 예약번호(/r) 학생 세션 JWT 서명 키 (랜덤 32자+)
STUDENT_SESSION_SECRET=       # CCC 로그인 학생 세션 JWT 서명 키 (랜덤 32자+)
# CCC 신원 전달 방식·검증 키는 CCC IT 확정 후 추가 (예: CCC_TOKEN_PUBLIC_KEY / CCC_VERIFY_URL)

# ─── 개발 전용 ─────────────────────────────────
# ENABLE_DEV_LOGIN=true        # /dev/login (seed 간사·마스터 로그인) 활성. ⚠️ 프로덕션 X

# ─── 알림 (출시 직전 확정) ──────────────────────
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=

# ─── cron (Vercel Cron / 송금 리마인더·익명화) ──
CRON_SECRET=                  # 랜덤 문자열. Vercel이 cron 요청에 Bearer로 주입

# ─── 모니터링 (Sentry) ──────────────────────────
# NEXT_PUBLIC_SENTRY_DSN=      # 있으면 에러 리포팅 활성, 없으면 no-op

# ─── 운영 이상 → GitHub Issue 자동화 (docs/ops/issue-automation.md) ──
# OPS_GITHUB_TOKEN=            # fine-grained PAT (repo Issues: write). 없으면 기능 no-op
# OPS_GITHUB_REPO=Lumiere001/bus-cignal   # 이슈를 만들 repo

# ─── CCC Summer 신원 핸드오프 (간사 로그인) ──────
# 시크릿 없음 — client_id + 등록된 redirect_uri로만 동작. docs/handoff-api 참조.
CCC_SUMMER_BASE=https://ccc-summer.vercel.app   # 운영 전환 시 https://sc2026.kccc.org 로 교체
CCC_HANDOFF_CLIENT_ID=bus-cignal                # 간사용 client_id (target_role=staff)
CCC_HANDOFF_STUDENT_CLIENT_ID=bus-cignal-student # 학생용 client_id (target_role=student)

# ─── Vercel·기타 ────────────────────────────────
# NEXT_PUBLIC_APP_URL=http://localhost:3000
